# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # safe for the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # SERVER-ONLY, never expose to the browser

# ---- WhatsApp Cloud API (Meta for Developers → your App → WhatsApp → API Setup) ----
WHATSAPP_PHONE_NUMBER_ID=1234567890            # the "Phone number ID" (not the phone number itself)
WHATSAPP_ACCESS_TOKEN=EAAG...                  # permanent access token (System User token, not the 24h test token)
WHATSAPP_VERIFY_TOKEN=choose-any-random-string # used to verify the webhook URL with Meta
WHATSAPP_HOSPITAL_NUMBER=905335024724          # the clinic's own WhatsApp number, digits only, country code first

# ---- App ----
NEXT_PUBLIC_APP_URL=https://vetoralive.example.com
